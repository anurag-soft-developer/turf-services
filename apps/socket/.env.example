PORT=3001
NODE_ENV=development
APP_NAME=turf-socket
APP_VERSION=1.0.0

# Redis (local: docker compose up -d)
REDIS_URL=redis://localhost:6379

# Chat persist tuning (interval becomes a seconds cron, min 1s)
CHAT_HISTORY_SIZE=100
CHAT_FLUSH_BATCH_SIZE=200
CHAT_FLUSH_INTERVAL_MS=5000

# Job schedules (socket ticks these; turf-services executes via /internal/jobs)
# PAYMENT_HOLD_RELEASE_CRON=*/2 * * * *
# TEAM_INVITE_EXPIRY_CRON=0 * * * *
# TEAM_MATCH_EXPIRY_CRON=*/5 * * * *
# ENGAGEMENT_STATS_FLUSH_CRON=*/2 * * * *
# UNUSED_UPLOAD_REGISTRY_PURGE_CRON=0 * * * *

# HTTP API (turf-services)
TURF_SERVICES_BASE_URL=http://localhost:3000
INTERNAL_TOKEN=change-me-internal

# Must match turf-services JWT_SECRET (websocket handshake)
JWT_SECRET=change-me-jwt-secret
