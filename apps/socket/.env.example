PORT=3001
NODE_ENV=development
APP_NAME=turf-socket
APP_VERSION=1.0.0

# Redis (local: docker compose up -d)
REDIS_URL=redis://localhost:6379

# Chat flush tuning
CHAT_HISTORY_SIZE=100
CHAT_FLUSH_BATCH_SIZE=200
CHAT_FLUSH_INTERVAL_MS=5000

# HTTP API (turf-services)
TURF_SERVICES_BASE_URL=http://localhost:3000
CHAT_BATCH_INTERNAL_TOKEN=change-me-chat-batch

# Must match turf-services JWT_SECRET (websocket handshake)
JWT_SECRET=change-me-jwt-secret

# Internal HTTP dispatch tokens (must match turf-services)
NOTIFICATION_INTERNAL_TOKEN=change-me-notification
SCORING_INTERNAL_TOKEN=change-me-scoring
