# Database
MONGODB_URI=mongodb://localhost:27017/turf-services

# JWT Configuration
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Application Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@turfservices.com

# Twilio SMS
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890

# Application Name
APP_NAME=Turf Services

# Razorpay (payments)
RAJORPAY_KEY_ID=
RAJORPAY_KEY_SECRET=
RAJORPAY_WEBHOOK_SECRET=
# Percentage kept as platform fee on each booking (default 10)
PLATFORM_FEE_PERCENT=10

# Realtime socket app (apps/socket on port 3001)
REALTIME_TURF_BASE_URL=http://localhost:3001
INTERNAL_TOKEN=change-me-internal

# Redis (engagement counters, explore seen-set, location throttle)
REDIS_URL=redis://127.0.0.1:6379
